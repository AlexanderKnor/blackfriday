{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deal",
  "description": "One Black Friday deal from an indie maker: <year>/<slug>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "url", "description", "category", "deal"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\n]+$" },
    "url": { "description": "Where to get the deal", "type": "string", "format": "uri", "pattern": "^https://" },
    "description": { "description": "What the product does", "type": "string", "minLength": 10, "maxLength": 160, "pattern": "^[^\\n]+$" },
    "category": { "description": "A slug from categories.json", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["mac", "ios", "ipad", "watch", "vision", "tv", "android", "windows", "linux", "web", "chrome"] }
    },
    "deal": { "description": "The offer in a few words", "type": "string", "minLength": 3, "maxLength": 90, "pattern": "^[^\\n]+$" },
    "code": { "description": "Coupon code, if one is needed", "type": "string", "pattern": "^[A-Za-z0-9_-]{3,30}$" },
    "pricing": { "enum": ["lifetime", "one-time", "subscription"] },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regular", "sale", "currency"],
      "properties": {
        "regular": { "type": "number", "exclusiveMinimum": 0 },
        "sale": { "type": "number", "minimum": 0 },
        "currency": { "description": "ISO 4217 code", "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "discount": { "description": "Percent off, 1 to 100", "type": "integer", "minimum": 1, "maximum": 100 },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" },
    "icon": { "description": "Square app icon or logo", "type": "string", "format": "uri", "pattern": "^https://" }
  }
}
